// Copy to ios/Config/Local.xcconfig (gitignored) and fill in.
// Your Apple team ID (Xcode > Settings > Accounts; free personal team is fine).
DEVELOPMENT_TEAM = ABCDE12345
// Unique per person so free-team bundle IDs don't collide, e.g. .tisya
BUNDLE_SUFFIX = .yourname
// Services to run for real on YOUR builds (space separated). Empty = all mocks.
// Names: perception locator headTracking audio voice telemetry
// Real services that need hardware (perception) still fall back to mocks in the simulator.
ECHORA_REAL_SERVICES =
// Live dashboard (live-dashboard/README.md). Empty = off.
// xcconfig treats // as a comment, so write the URL with $() between the slashes:
//   ECHORA_LIVE_URL = https:/$()/your-tunnel.trycloudflare.com
//   ECHORA_LIVE_URL = http:/$()/172.20.10.2:8787
ECHORA_LIVE_URL =
